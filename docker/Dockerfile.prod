# Продакшн-образ. Собирается один раз, из него берутся два таргета: web и api.
# Сборка: docker compose -f docker/docker-compose.prod.yml build

# node:22-alpine, а не oven/bun: рантайм Next остаётся на Node, а Docker Hub
# с российских адресов ограничивает анонимные загрузки. bun ставится из npm.
FROM node:22-alpine AS base
# Единственный внешний источник — реестр npm. Подменяется при сборке:
#   docker build --build-arg NPM_REGISTRY=https://зеркало ...
ARG NPM_REGISTRY=https://registry.npmjs.org
ENV BUN_CONFIG_REGISTRY=$NPM_REGISTRY
RUN npm i -g bun@1.3.8 --no-fund --no-audit --registry="$NPM_REGISTRY"
WORKDIR /app
ENV CI=true

# ---------- зависимости ----------
# Плоская раскладка задана в bunfig.toml: standalone-сборка Next копирует
# node_modules как есть, а симлинки изолированного линкера указывают на общее
# хранилище вне копируемого дерева и в образе ломаются
FROM base AS deps
COPY package.json bun.lock bunfig.toml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/db/package.json packages/db/package.json
RUN bun install --frozen-lockfile

# ---------- сборка Next ----------
FROM base AS web-builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# Сам Next собирается под Node: bun run запускает бинарь с шебангом node как
# есть, и standalone-выход не отличается от прежнего
RUN bun run --filter @kjar/web build

# ---------- рантайм Next ----------
# standalone уже содержит нужные модули, остальное не тащим
FROM node:22-alpine AS web
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001
# outputFileTracingRoot в next.config указывает на корень монорепо,
# поэтому standalone повторяет структуру: server.js лежит в apps/web
COPY --from=web-builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=web-builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=web-builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
USER nextjs
EXPOSE 3000
CMD ["node", "apps/web/server.js"]

# ---------- рантайм API ----------
# @kjar/db отдаёт исходники на TypeScript, и bun исполняет их напрямую:
# отдельный шаг сборки и загрузчик tsx больше не нужны
FROM base AS api
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package.json bun.lock bunfig.toml ./
COPY apps/api ./apps/api
COPY packages/db ./packages/db
# Ссылка на workspace-пакет: на этапе deps исходников пакета ещё нет,
# поэтому ссылка там висит в пустоту и её нужно переставить
RUN mkdir -p node_modules/@kjar && ln -sfn /app/packages/db node_modules/@kjar/db
RUN addgroup -g 1001 -S nodejs && adduser -S api -u 1001 && chown -R api:nodejs /app
USER api
WORKDIR /app/apps/api
EXPOSE 3001
CMD ["bun", "src/index.ts"]
