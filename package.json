{
  "name": "kjar",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./run-dev.sh",
    "db:generate": "bun run --filter @kjar/db generate",
    "db:migrate": "bun run --filter @kjar/db migrate",
    "db:migrate:node": "bun run --filter @kjar/db migrate:direct",
    "db:migrate:docker": "./scripts/migrate-docker.sh",
    "db:push": "bun run --filter @kjar/db push",
    "db:studio": "bun run --filter @kjar/db studio",
    "db:introspect": "bun run --filter @kjar/db introspect",
    "db:seed": "SEED_LOCALHOST=1 bun run --filter @kjar/db seed",
    "db:seed:docker": "./scripts/seed-docker.sh"
  },
  "packageManager": "bun@1.3.8"
}
