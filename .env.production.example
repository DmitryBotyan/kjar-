# Боевое окружение. Скопировать в .env.production и заполнить.
# Секреты сгенерировать: openssl rand -hex 32

POSTGRES_USER=kjar
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=kjar
# Внутри сети docker база доступна по имени сервиса db
DATABASE_URL=postgres://kjar:CHANGE_ME_strong_password@db:5432/kjar

JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Домен сайта. Пока домена нет — IP сервера
CORS_ORIGIN=https://example.ru
NEXT_PUBLIC_SITE_URL=https://example.ru

# Строгий лимит запросов (в dev было 60000/600)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Объектное хранилище Timeweb (S3-совместимое).
# Если используете локальный MinIO, поменяйте endpoint на http://minio:9000
S3_ENDPOINT=https://s3.twcstorage.ru
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=kjar
S3_REGION=ru-1
S3_PUBLIC_URL=https://s3.twcstorage.ru/kjar
