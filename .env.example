POSTGRES_USER=kjar
POSTGRES_PASSWORD=kjar_password
POSTGRES_DB=kjar
DATABASE_URL=postgres://kjar:kjar_password@db:5432/kjar
# Порт, на котором БД видна с хоста (внутри docker всегда 5432)
DB_PORT=5433
# Порты, которые сервисы занимают на хосте (меняйте при конфликтах)
WEB_PORT=3000
API_PORT=3001
ADMINER_PORT=8081
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

PORT=3001
BCRYPT_SALT_ROUNDS=12
# Сгенерировать своё: openssl rand -hex 32
JWT_SECRET=replace_me_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
# Лимит запросов к API (dev): окно и максимум
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

NEXT_PUBLIC_API_BASE=http://localhost:3001/api/v1

# MinIO / S3 Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kjar
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000
